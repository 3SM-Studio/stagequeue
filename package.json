{
  "name": "poza-nuta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "build": "pnpm build:public && pnpm build:dashboard",
    "build:dashboard": "pnpm --filter @poza-nuta/dashboard-web build",
    "build:public": "pnpm --filter @poza-nuta/public-web build",
    "build:web": "pnpm build:public",
    "build:web:legacy": "vite build --config apps/web/vite.config.ts",
    "check:architecture": "node --experimental-strip-types scripts/typecheck.mjs",
    "dev": "concurrently -k -n API,PUBLIC,DASHBOARD -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:public\" \"pnpm dev:dashboard\"",
    "dev:api": "pnpm --filter @poza-nuta/api dev",
    "dev:api:legacy": "node --watch --experimental-strip-types apps/api/src/server.ts",
    "dev:dashboard": "pnpm --filter @poza-nuta/dashboard-web dev",
    "dev:public": "pnpm --filter @poza-nuta/public-web dev",
    "dev:legacy": "concurrently -k -n API_LEGACY,WEB_LEGACY -c cyan,magenta \"pnpm dev:api:legacy\" \"pnpm dev:web:legacy\"",
    "dev:web:legacy": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:worker": "echo \"apps/worker scaffold is present; worker process will be added in a later phase\"",
    "db:generate": "pnpm --filter @poza-nuta/db db:generate",
    "db:migrate": "pnpm --filter @poza-nuta/db db:migrate",
    "db:seed:catalog": "pnpm --filter @poza-nuta/db db:seed:catalog",
    "db:seed:demo": "pnpm --filter @poza-nuta/db db:seed:demo",
    "db:studio": "pnpm --filter @poza-nuta/db db:studio",
    "check:clean-package": "node scripts/check-clean-package.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "format": "biome format --write .",
    "import:ising": "node --experimental-strip-types src/importers/ising/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "queue": "node --experimental-strip-types src/queue/cli.ts",
    "pack:source": "git archive --format zip --output poza-nuta-source.zip HEAD && node scripts/check-clean-package.mjs poza-nuta-source.zip",
    "search:songs": "node --experimental-strip-types src/search/cli.ts",
    "smoke:api": "pnpm --filter @poza-nuta/api smoke",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "pnpm check:architecture && pnpm --filter @poza-nuta/domain typecheck && pnpm --filter @poza-nuta/db typecheck && pnpm --filter @poza-nuta/api typecheck && pnpm --filter @poza-nuta/shared typecheck && pnpm --filter @poza-nuta/public-web typecheck && pnpm --filter @poza-nuta/dashboard-web typecheck && tsc -p tsconfig.tests.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
