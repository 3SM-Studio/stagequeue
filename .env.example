ISING_API_BASE_URL=https://api.ising.pl/v2
ISING_CLIENT_ID=replace_me
ISING_IMPORT_DELAY_MS=3000
ISING_IMPORT_TAG=
ISING_IMPORT_ORDER=-artist_string
# Optional contact email for internal documentation/logging only.
ISING_IMPORT_CONTACT_EMAIL=
# Optional custom User-Agent. Leave empty to behave like the default runtime/client.
ISING_IMPORT_USER_AGENT=
API_HOST=127.0.0.1
API_PORT=4321
# Required if the legacy API is ever run with NODE_ENV=production.
API_ADMIN_TOKEN=
API_LOG_LEVEL=info
VITE_API_BASE_URL=http://127.0.0.1:4321

# Target platform placeholders for the Fastify API / Next.js apps.
API_URL=http://localhost:4321
PUBLIC_WEB_URL=http://localhost:3000
DASHBOARD_WEB_URL=http://localhost:3001
COOKIE_DOMAIN=localhost
DATABASE_URL=postgres://poza_nuta:poza_nuta@localhost:5432/poza_nuta
# Optional in development/test. Required when NODE_ENV=production; enables Redis-backed EventBus for SSE fanout.
REDIS_URL=
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
AUTH_SECRET=replace_me_with_at_least_32_random_characters
PARTICIPANT_TOKEN_SECRET=replace_me_with_at_least_32_random_characters
PUBLIC_REQUEST_MAX_ACTIVE_PER_PARTICIPANT=3
PUBLIC_REQUEST_COOLDOWN_SECONDS=20
# Development/test-only fallback. Production rejects this env; use PLATFORM_SETUP_TOKEN and /setup.
BOOTSTRAP_PLATFORM_OWNER_EMAIL=replace_me@example.com
PLATFORM_SETUP_ENABLED=true
PLATFORM_SETUP_TOKEN=replace_me_with_one_time_setup_token
