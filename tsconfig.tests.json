{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@poza-nuta/db": ["packages/db/src/index.ts"],
      "@poza-nuta/domain": ["packages/domain/src/index.ts"],
      "@poza-nuta/domain/permissions": ["packages/domain/src/permissions/index.ts"],
      "@poza-nuta/shared": ["packages/shared/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["tests/**/*.test.ts"],
  "exclude": ["node_modules"]
}
